# Base URL of the LEDGER service. Server-side only; never expose the token to the browser.
LEDGER_API_BASE_URL=http://127.0.0.1:8080

# Bearer token for the locally running service. Required by every /v1 endpoint
# except /v1/health and /v1/ready. Supply through the environment or a secret
# manager. Never commit a real token.
#
# Development shortcut (matches the service's LEDGER_API_TOKENS setting):
#   LEDGER_API_TOKEN=dev-token
# Production expects a signed, expiring token (LEDGER_TOKEN_SECRET).
LEDGER_API_TOKEN=

# Optional: client-supplied correlation id echoed by the API. Useful when
# reproducing a request in the service logs.
# LEDGER_API_CORRELATION_ID=
