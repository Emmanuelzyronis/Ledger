{
  "name": "ledger-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "LEDGER reconciliation dashboard. Consumes only the published /v1 OpenAPI contract.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "generate:api": "node scripts/generate-api-client.mjs",
    "check": "npm run generate:api && npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.25",
    "openapi-typescript": "7.9.1",
    "postcss": "8.5.28",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.4"
  }
}
