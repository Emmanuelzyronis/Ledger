# Development environment. Copy to development.env (git-ignored) and edit.
LEDGER_ENV=development
LEDGER_LOG_LEVEL=DEBUG
LEDGER_REQUIRE_TLS=false
LEDGER_DATABASE_PATH=/var/lib/ledger/ledger.sqlite3
# Development-only opaque tokens: token:role[:source|source]
LEDGER_API_TOKENS=dev-token:reconciliation_operator:source-a|source-b
