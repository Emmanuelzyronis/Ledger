# Production environment. Copy to production.env and fill from the secret store.
# Prefer the platform's secret injection over an env file (docs/deployment.md §4).
LEDGER_ENV=production
LEDGER_LOG_LEVEL=INFO
LEDGER_REQUIRE_TLS=true
LEDGER_CORS_ORIGINS=https://ledger.example.com
LEDGER_RATE_LIMIT_PER_MINUTE=600
LEDGER_MAX_CONCURRENT_REQUESTS=64
LEDGER_DRAIN_TIMEOUT_SECONDS=20
# 32+ random bytes, supplied by the secret store - never committed.
LEDGER_TOKEN_SECRET=
