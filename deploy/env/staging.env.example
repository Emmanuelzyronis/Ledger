# Staging environment. Copy to staging.env and fill from the secret store.
LEDGER_ENV=production
LEDGER_LOG_LEVEL=INFO
LEDGER_REQUIRE_TLS=true
LEDGER_CORS_ORIGINS=https://ledger-staging.example.com
LEDGER_RATE_LIMIT_PER_MINUTE=600
LEDGER_MAX_CONCURRENT_REQUESTS=64
# 32+ random bytes, supplied by the secret store - never committed.
LEDGER_TOKEN_SECRET=
