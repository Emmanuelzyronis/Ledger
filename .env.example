# Non-secret runtime configuration. Copy to a local environment file; never commit secrets.
LEDGER_ENV=development
LEDGER_LOG_LEVEL=INFO
LEDGER_TELEMETRY_ENABLED=true

# Secrets must be supplied by the runtime environment or a secret manager.
# LEDGER_DATABASE_URL=
# LEDGER_API_TOKEN=

# Service boundary (docs/service.md)
LEDGER_HOST=127.0.0.1
LEDGER_PORT=8080
LEDGER_DATABASE_PATH=ledger.sqlite3
LEDGER_MAX_BODY_BYTES=1048576
LEDGER_DRAIN_TIMEOUT_SECONDS=10
# Identity. Prefer LEDGER_TOKEN_SECRET (signed, expiring tokens). LEDGER_API_TOKENS
# is for local development only. Never commit real credentials.
# LEDGER_TOKEN_SECRET=
# LEDGER_API_TOKENS=

# Request boundary and abuse controls (docs/security.md)
LEDGER_MAX_JSON_DEPTH=32
LEDGER_RATE_LIMIT_PER_MINUTE=0
LEDGER_REQUIRE_TLS=false
# LEDGER_CORS_ORIGINS=https://app.example.com
